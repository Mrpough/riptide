{
  "manifest_version": 3,
  "name": "Riptide Download Manager",
  "version": "0.1.0",
  "description": "Send links and media to Riptide, a fast multi-connection download manager for Windows.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Riptide",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "downloads", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
