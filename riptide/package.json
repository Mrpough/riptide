{
  "name": "riptide",
  "version": "0.1.0",
  "description": "Riptide — a fast, multi-connection download manager with queueing, scheduling, categories and auto-update.",
  "author": {
    "name": "Riptide",
    "email": "you@example.com"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/riptide",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run gen:assets && electron-vite build && electron-builder --publish never",
    "dist:win": "npm run gen:assets && electron-vite build && electron-builder --win --publish never",
    "release": "npm run gen:assets && electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "undici": "8.12.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
